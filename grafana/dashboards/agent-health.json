{
  "uid": "ta-agent-health",
  "title": "Telemetry Analyst — Agent Health",
  "tags": ["telemetry-analyst", "agent", "ai", "llm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "Prometheus"}
      },
      {
        "name": "mode",
        "label": "Mode",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
        "query": "label_values(ta_agent_response_latency_seconds_bucket, mode)",
        "includeAll": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Response latency percentiles (mode=$mode)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ta_agent_response_latency_seconds_bucket{mode=~\"$mode\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ta_agent_response_latency_seconds_bucket{mode=~\"$mode\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ta_agent_response_latency_seconds_bucket{mode=~\"$mode\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second (by mode)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (rate(ta_agent_response_latency_seconds_count[5m]))",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tool invocations (by tool, outcome)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, outcome) (rate(ta_agent_tool_invocations_total[5m]))",
          "legendFormat": "{{tool}} ({{outcome}})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tool error rate (5m)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ta_agent_tool_invocations_total{outcome!=\"ok\"}[5m])) / ignoring() sum(rate(ta_agent_tool_invocations_total[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active sessions",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "targets": [
        {"refId": "A", "expr": "sum(ta_agent_active_sessions)"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM tokens per second (by kind)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, model) (rate(ta_agent_llm_tokens_total[5m]))",
          "legendFormat": "{{kind}} ({{model}})"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Top 10 most used tools (5m)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (tool) (rate(ta_agent_tool_invocations_total[5m])))",
          "legendFormat": "{{tool}}"
        }
      ]
    }
  ]
}
