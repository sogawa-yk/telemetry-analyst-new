# Chainlit UI 用イメージ (ta-agent-ui / port 8081)
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/

RUN pip install --upgrade pip && pip install '.[ui]'

RUN useradd -u 10001 -m ta && chown -R ta:ta /app
USER ta

EXPOSE 8081

CMD ["chainlit", "run", "src/ta/ui/chainlit_app.py", \
     "--host", "0.0.0.0", "--port", "8081", "--headless"]
