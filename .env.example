# OCI Enterprise AI (Responses / Conversations API、OpenAI SDK 互換)
OPENAI_API_KEY=<secret:oci-genai-key/api_key>
OPENAI_BASE_URL=https://inference.generativeai.ap-osaka-1.oci.oraclecloud.com/openai/v1
OCI_GENAI_PROJECT=ocid1.generativeaiproject.oc1.ap-osaka-1.amaaaaaassl65iqak67q6dr5zu6jqoimgf54sylota5devqglzkkoenxznxa
OCI_GENAI_MODEL=openai.gpt-4.1

# Langfuse (LLM 可観測性 + LLM-as-Judge)
LANGFUSE_HOST=http://langfuse-web.langfuse.svc.cluster.local:3000
LANGFUSE_PUBLIC_KEY=<secret:langfuse-keys/public_key>
LANGFUSE_SECRET_KEY=<secret:langfuse-keys/secret_key>

# OpenTelemetry Collector (既存クラスタの共通 Collector)
OTEL_SERVICE_NAME=ta-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-gateway-opentelemetry-collector.observability:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Grafana (MCP + ダッシュボード)
GRAFANA_URL=http://prometheus-grafana.observability.svc.cluster.local:3000
GRAFANA_TOKEN=<secret:ta-agent-grafana/GRAFANA_TOKEN>
GRAFANA_EXTERNAL_URL=https://grafana.devday26.sogawa-yk.com
MCP_GRAFANA_URL=http://mcp-grafana.telemetry-analyst.svc:8000/mcp

# K8s 監視対象
TA_TARGET_NAMESPACE=ec-shop

# Chainlit UI → バックエンド API
TA_AGENT_URL=http://ta-agent:8080

# ガードレール
TA_MAX_TOOL_CALLS=20
TA_REQUEST_TIMEOUT_SEC=120
TA_DEFAULT_MODE=engineer

# ログレベル
TA_LOG_LEVEL=INFO
